<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.argusprojects</groupId>
    <artifactId>argus-mc</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Argus MC</name>
    <description>Minecraft plugin for Argus Projects — issues SS scan tokens via /ss command (LuckyPerms compatible)</description>
    <url>https://argusprojects.com</url>

    <properties>
        <!-- Java 21: requerido por paper-api 1.20.5+ y todas las 1.21.x.
             Aternos / Spigot 1.20 corre con JDK 21 sin problemas. -->
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <!-- Spigot/Paper API -->
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- LuckyPerms (opcional, hookeamos solo si esta presente en runtime) -->
        <repository>
            <id>luckperms</id>
            <url>https://repo.lucko.me/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
        <!-- PacketEvents repo (Pack 47) -->
        <repository>
            <id>codemc-releases</id>
            <url>https://repo.codemc.io/repository/maven-releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API (compatible con Spigot) — provided porque el server lo aporta.
             OJO: PaperMC borra las versiones viejas de su repo Maven (al 2026-05
             solo mantienen 1.21.3+). Por eso compilamos contra 1.21.3-R0.1-SNAPSHOT
             aunque el plugin declare api-version: '1.19' en plugin.yml. El plugin
             solo usa APIs Bukkit estables desde 1.13, asi que el .jar resultante
             corre perfectamente en Spigot/Paper 1.19, 1.20.x, 1.21.x sin recompilar.
             Verificado en Aternos 1.20 con Spigot. Si en el futuro PaperMC borra
             tambien 1.21.3, subir a la version mas vieja disponible. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.3-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- LuckyPerms API — provided, soft-dep en runtime. No requerido para compilar logica core. -->
        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
            <version>5.4</version>
            <scope>provided</scope>
        </dependency>

        <!-- PacketEvents (Pack 47) — provided, soft-dep en runtime.
             Anti-cheat packet-based de Grim/Polar/Vulcan level. Si el server tiene
             PacketEvents instalado, los checks packet-based se activan. Si no,
             el plugin sigue funcionando con el AnticheatListener Bukkit-based.
             Compatible 1.8 a 1.21+. -->
        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>2.6.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>argus-mc-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
