# Archivos temporales del agente
.commit_msg.tmp
*.tmp.txt

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
.eggs/

# Entornos virtuales
venv/
env/
ENV/
.venv
.venv*/

# Bases de datos locales (no subir datos de desarrollo)
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# Compilación del .exe — ignorar archivos intermedios pero incluir el exe distribuible
source/build/
source/dist/*
!source/dist/ArgusScanner.exe

# Builds PyInstaller alternativos (60/new/new2/...) y bundles offline — artefactos, ~500 MB
source/build_*/
source/dist_*/
source/bundle/
source/argus_report_local.html
web_app/downloads/
.coverage
.coverage.*

# Archivos sensibles
.env
.env.local
web_app/.env.local
tokens.json

# config.json raíz (credenciales locales)
/config.json
/scanner_db.sqlite

# Logs
*.log
logs/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Archivos de diagnóstico / desarrollo
web_app/auth.db
web_app/diagnostico_login.html

# Tools — credenciales del CLI inspector (nunca subir)
tools/.argus_creds.json

# Carpeta logo/ — diseños raw subidos por el usuario (SVG/PNG fuente, no se sirven)
logo/

# Artefactos de build PyInstaller en raíz (ya cubrimos source/build y source/dist arriba)
/build/
/dist/
argus-admin/build/
argus-admin/dist/

# Mensaje temporal de commit (workaround para PowerShell que no soporta heredoc)
.commit_msg.txt
web_app/static/img/*.bak

# Bot de Discord
bot/.env
bot/data/transcripts/
__pycache__/
*.pyc

