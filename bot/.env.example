# ─────────────────────────────────────────────────────────────────────
# Argus Discord Bot — variables de entorno
# Copia este archivo como .env y rellena los valores reales.
# ─────────────────────────────────────────────────────────────────────

# Token del bot (Discord Developer Portal -> tu app -> Bot -> Token)
DISCORD_TOKEN=PEGA_AQUI_TU_TOKEN

# ID del servidor (guild) donde corre el bot.
# Click derecho al server con Modo Desarrollador activado -> Copiar ID
DISCORD_GUILD=000000000000000000

# (Opcional) ID del owner del bot — recibe DMs de errores criticos.
DISCORD_OWNER_ID=000000000000000000

# Postgres external URL de Render (la misma que usa el web app).
# Formato: postgresql://USER:PASS@HOST/DB
DATABASE_URL=postgresql://aspers_db_user:zgwgt9YCincIkxmwrBKOIUpg3PHMPTIO@dpg-d7g3iobeo5us73bfrv10-a.oregon-postgres.render.com/aspers_db

# (Opcional) Prefijo de comandos textuales legacy. Por defecto el bot usa solo slash commands.
COMMAND_PREFIX=!

# (Opcional) URL base del panel web — usada en links de los embeds.
PANEL_URL=https://asperss.onrender.com

# (Opcional) Debug — log mas verbose si =1
BOT_DEBUG=0
