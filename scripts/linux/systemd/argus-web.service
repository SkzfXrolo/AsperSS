[Unit]
Description=Argus Web Service
After=network.target

[Service]
Type=simple
User=argus
Group=argus
WorkingDirectory=/opt/argus
ExecStart=/usr/bin/python -m web_app.app
Restart=always
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/argus

[Install]
WantedBy=multi-user.target
