# Argus Projects — normalización de line endings
#
# Crítico para el scanner Linux: los .sh y .py deben mantenerse LF
# siempre, porque CRLF en el shebang rompe el interpreter en Linux
# ("bash\r: bad interpreter: No such file or directory").

# Por defecto, Git decide
*           text=auto

# Shell scripts y Python: SIEMPRE LF
*.sh        text eol=lf
*.py        text eol=lf

# Web frontend: LF también (consistencia con linters)
*.css       text eol=lf
*.js        text eol=lf
*.html      text eol=lf

# Markdown / docs: LF
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf

# Binarios — no tocar
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ico       binary
*.exe       binary
*.dll       binary
*.so        binary
*.appimage  binary
*.tar.gz    binary
*.zip       binary
