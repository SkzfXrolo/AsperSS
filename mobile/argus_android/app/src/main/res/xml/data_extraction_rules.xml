<?xml version="1.0" encoding="utf-8"?>
<!-- Argus no respalda nada: no queremos que el token se sincronice
     con la nube de Google. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="device" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="device" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
