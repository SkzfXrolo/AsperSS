# Copiar a: web_app/.env.local  (NO subir a git)
# Réplica local del panel https://asperss.onrender.com

# Activa modo local privado (solo 127.0.0.1)
ARGUS_LOCAL_DEV=1
PORT=8080
FLASK_DEBUG=1

# Misma app monolítica que en Render (no hace falta api_server.py en :5000)
API_URL=http://127.0.0.1:8080

# PostgreSQL de Render → Dashboard → aspers-db → Connect → External Database URL
# Pegar la URL completa (postgresql://...)
DATABASE_URL=

# Opcional: mismo SECRET_KEY que Render si quieres reutilizar cookies (no recomendado)
# SECRET_KEY=

# Opcional: capa extra — solo quien tenga este valor accede al panel local
# LOCAL_DEV_SECRET=cambia-esto-por-algo-largo

# Argus Core (copiloto del panel) — motor Gemini, conversación scan a scan
GEMINI_API_KEY=
ARGUS_CORE_PROVIDER=gemini
# Si gemini-2.0-flash falla en tu cuenta, probá:
# ARGUS_GEMINI_MODEL=gemini-2.5-flash

# Opcional: ensemble Claude+Groq+Gemini (en lugar de solo Gemini)
# ARGUS_CORE_PROVIDER=ensemble
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# ArgusAdmin (exe SuperAdmin + voz) — solo owner del panel
# ARGUS_ADMIN_JWT_SECRET=genera-un-secreto-largo-unico
# ARGUS_PANEL_OWNER_USERNAMES=Rodrigo
# Si /aspers-sa usa SUPER_ADMIN_USER (no está en tabla users):
# ARGUS_ADMIN_LINK_USER_ID=1

# DISCORD_BOT_TOKEN=
